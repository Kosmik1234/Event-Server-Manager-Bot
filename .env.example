# Copy to .env and fill in. NEVER commit .env.
DISCORD_BOT_TOKEN=your-token-here

# Name or ID of the role (besides Administrators) allowed to create events
MODERATOR_ROLE=Moderator

# Optional: your test server's ID. Slash commands sync instantly to one guild
# (global sync can take up to an hour).
DEV_GUILD_ID=

# Where events are saved. On Railway, point this at a mounted Volume (e.g. /data/events.json)
EVENTS_FILE=data/events.json

# Where per-server settings (e.g. allowed event categories) are saved.
GUILD_SETTINGS_FILE=data/guild_settings.json
